{
  "presets": ["@babel/preset-react"],
  "plugins": [
    ["module-resolver", {
      "root": ["./"],
      "alias": {
        "@components": "./src/components",
        "@constants": "./src/constants",
        "@icons": "./src/assets/icons",
        "@images": "./src/assets/images",
        "@src": "./src",
        "@store": "./src/store",
        "@utils": "./src/utils"
      }
    }]
  ]
}
